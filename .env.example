# ก๊อปไฟล์นี้เป็น .env.local แล้วเติมค่าให้ครบ

# Web app URL ที่ได้จาก Deploy > New deployment > Web app ของ Apps Script
# หน้าตาประมาณ https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_SHEET_API_URL=

# OAuth 2.0 Client ID (Web application) จาก Google Cloud Console
# ต้องเป็นค่าเดียวกับ GOOGLE_CLIENT_ID ใน google-app-script/code.gs
# และต้องใส่ Authorized JavaScript origins ให้ครบทุก origin ที่จะเปิดเว็บ
# เช่น http://localhost:5173 และโดเมนจริงตอน deploy
VITE_GOOGLE_CLIENT_ID=
