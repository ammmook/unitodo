# ก๊อปไฟล์นี้เป็น .env.local แล้วเติมค่าให้ครบ
# (`neon deploy` จะเติม DATABASE_URL / NEON_REALTIME_URL / NEON_REALTIME_SECRET ให้เอง)

# OAuth 2.0 Client ID (Web application) จาก Google Cloud Console
# ใช้ทั้งหน้าเว็บ (ปุ่ม Google) และ server (ตรวจ ID token) — ต้องใส่ Authorized JavaScript origins ให้ครบ
VITE_GOOGLE_CLIENT_ID=

# (ไม่บังคับ) อีเมล admin ตั้งต้น คั่นด้วย , — ถ้าว่าง ผู้ใช้คนแรกที่ล็อกอินได้เป็น admin
BOOTSTRAP_ADMIN_EMAILS=

# (ไม่บังคับ) URL ของ backend ถ้าไม่ใช่ /api
# VITE_API_URL=
